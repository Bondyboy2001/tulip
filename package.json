{
  "name": "tulip",
  "version": "0.1.21",
  "description": "A minimal markdown editor and language-learning vault",
  "main": "electron/main.js",
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "test": "npm run test:srs && npm run test:study-match && npm run test:language-cards && npm run test:language-keyboard && npm run test:language-row && npm run test:lint && npm run test:ai && npm run test:ai-lifecycle && npm run test:pdf && npm run test:tex && npm run test:language-history && npm run test:optimizations && npm run test:renderer-optimizations && npm run test:codeblocks && npm run test:diff && npm run test:search-narrow && npm run test:config-keys && npm run test:safe-name && npm run test:whiteboard && npm run test:ui-contracts && npm run test:table && npm run test:export-print",
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "start": "npm run build && electron .",
    "app": "./scripts/build-app.sh",
    "tidy": "node scripts/tidy-vault.mjs",
    "test:srs": "esbuild scripts/test-srs.mjs --bundle --format=esm --platform=node --outfile=node_modules/.cache/test-srs.mjs --log-level=error && node node_modules/.cache/test-srs.mjs",
    "test:lint": "esbuild scripts/test-lint.mjs --bundle --format=esm --platform=node --outfile=node_modules/.cache/test-lint.mjs --log-level=error && node node_modules/.cache/test-lint.mjs",
    "test:ai": "esbuild scripts/test-ai.mjs --bundle --format=cjs --platform=node --outfile=node_modules/.cache/test-ai.cjs --log-level=error && node node_modules/.cache/test-ai.cjs",
    "test:ai-lifecycle": "esbuild scripts/test-ai-lifecycle.mjs --bundle --format=esm --platform=node --outfile=node_modules/.cache/test-ai-lifecycle.mjs --log-level=error && node node_modules/.cache/test-ai-lifecycle.mjs",
    "test:pdf": "esbuild scripts/test-pdf.mjs --bundle --format=esm --platform=node --outfile=node_modules/.cache/test-pdf.mjs --log-level=error && node node_modules/.cache/test-pdf.mjs",
    "test:tex": "node scripts/test-tex.cjs",
    "test:study-match": "esbuild scripts/test-study-match.mjs --bundle --format=esm --platform=node --outfile=node_modules/.cache/test-study-match.mjs --log-level=error && node node_modules/.cache/test-study-match.mjs",
    "test:language-cards": "esbuild scripts/test-language-cards.mjs --bundle --format=esm --platform=node --outfile=node_modules/.cache/test-language-cards.mjs --log-level=error && node node_modules/.cache/test-language-cards.mjs",
    "test:language-keyboard": "esbuild scripts/test-language-keyboard.mjs --bundle --format=esm --platform=node --outfile=node_modules/.cache/test-language-keyboard.mjs --log-level=error && node node_modules/.cache/test-language-keyboard.mjs",
    "test:language-row": "node scripts/test-language-row.cjs",
    "test:language-history": "node scripts/test-language-history.cjs",
    "test:optimizations": "node scripts/test-optimizations.cjs",
    "test:renderer-optimizations": "esbuild scripts/test-renderer-optimizations.mjs --bundle --format=esm --platform=node --outfile=node_modules/.cache/test-renderer-optimizations.mjs --log-level=error && node node_modules/.cache/test-renderer-optimizations.mjs",
    "test:codeblocks": "esbuild scripts/test-codeblock-performance.mjs --bundle --format=esm --platform=node --loader:.svg=text --outfile=node_modules/.cache/test-codeblock-performance.mjs --log-level=error && node node_modules/.cache/test-codeblock-performance.mjs",
    "test:diff": "esbuild scripts/test-diff.mjs --bundle --format=esm --platform=node --outfile=node_modules/.cache/test-diff.mjs --log-level=error && node node_modules/.cache/test-diff.mjs",
    "test:table": "node scripts/test-table.mjs",
    "test:build-staging": "node scripts/test-build-staging.cjs",
    "verify": "npm test && npm run build && npm run test:build-staging",
    "bench": "node bench/bench.mjs",
    "bench:dom": "node bench/dom-bench.mjs",
    "bench:reading": "node bench/reading-bench.mjs",
    "test:search-narrow": "node scripts/test-search-narrow.cjs",
    "test:config-keys": "node scripts/test-config-keys.cjs",
    "test:safe-name": "node scripts/test-safe-name.cjs",
    "test:whiteboard": "node scripts/test-whiteboard.cjs",
    "test:ui-contracts": "esbuild scripts/test-ui-contracts.mjs --bundle --format=esm --platform=node --outfile=node_modules/.cache/test-ui-contracts.mjs --log-level=error && node node_modules/.cache/test-ui-contracts.mjs",
    "test:export-print": "node scripts/test-export-print.cjs",
    "test:agent-diff": "node scripts/test-agent-diff.mjs",
    "test:reading-list": "node scripts/test-reading-list.mjs",
    "bench:table": "node bench/table-bench.mjs",
    "app:stage": "./scripts/build-app.sh --no-install",
    "app:win": "node scripts/build-win.mjs"
  },
  "_overrides": [
    "Two transitive packages arrive vulnerable and neither publisher has moved.",
    "lodash-es: chevrotain pins 4.17.21, whose _.template is a code-injection",
    "  hole. It reaches us through mermaid -> @mermaid-js/parser -> langium.",
    "  4.18.1 is the patched line and is already what the rest of the tree uses.",
    "nanoid: excalidraw pins 3.3.3 and mermaid-to-excalidraw pins 4.0.2, both of",
    "  which return predictable ids for a non-integer size. 3.3.17 is the patched",
    "  end of the line that both of those API generations are compatible with;",
    "  the alternative npm offers is downgrading excalidraw a whole major.",
    "Recheck on every mermaid/excalidraw bump — an override outliving its reason",
    "is how a tree ends up pinned to something older than the dependency wants."
  ],
  "overrides": {
    "lodash-es": "4.18.1",
    "nanoid": "3.3.17"
  },
  "allowScripts": {
    "esbuild": true,
    "electron": true
  },
  "devDependencies": {
    "electron": "43.2.0",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@excalidraw/excalidraw": "^0.18.1",
    "@lezer/highlight": "^1.2.3",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.16.0",
    "nspell": "^2.1.5",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.27.1",
    "three": "^0.185.1"
  }
}
